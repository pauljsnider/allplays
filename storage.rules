rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedForSensitiveWrite() {
      let policyPath = /databases/(default)/documents/securityPolicies/verifiedEmail;
      return isSignedIn() &&
        (request.auth.token.get('email', null) == null ||
         request.auth.token.get('email_verified', false) == true ||
         request.auth.token.get('email_verification_exempt', false) == true ||
         !firestore.exists(policyPath) ||
         firestore.get(policyPath).data.get('mode', 'observe') != 'enforce' ||
         request.auth.uid in firestore.get(policyPath).data.get('exemptUserIds', []));
    }

    function isGlobalAdmin() {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isTeamOwnerOrAdmin(teamId) {
      let team = firestore.get(/databases/(default)/documents/teams/$(teamId)).data;
      let ownerEmail = team.get('ownerEmail', '');
      let ownerEmailLower = team.get('ownerEmailLower', '');
      return isSignedIn() &&
        (team.ownerId == request.auth.uid ||
         (request.auth.token.email != null &&
          request.auth.token.get('email_verified', false) == true &&
          team.get('ownerId', '') == '' &&
          ownerEmail is string &&
          ownerEmailLower is string &&
          (ownerEmail != '' || ownerEmailLower != '') &&
          (ownerEmail == '' || ownerEmailLower == '' || ownerEmail.lower() == ownerEmailLower.lower()) &&
          (ownerEmail.lower() == request.auth.token.email.lower() ||
           ownerEmailLower.lower() == request.auth.token.email.lower())) ||
         (request.auth.token.email != null &&
          request.auth.token.get('email_verified', false) == true &&
          request.auth.token.email.lower() in team.get('adminEmails', [])) ||
         isGlobalAdmin());
    }

    function teamPermission(teamId, permissionName) {
      return firestore.get(/databases/(default)/documents/teams/$(teamId)).data
        .get('teamPermissions', {})
        .get(permissionName, {});
    }

    function canManageTeamMedia(teamId) {
      return isTeamOwnerOrAdmin(teamId) ||
        (isSignedIn() &&
         teamPermission(teamId, 'teamMediaManagement').get('mode', '') == 'selected' &&
         request.auth.uid in teamPermission(teamId, 'teamMediaManagement').get('memberIds', []));
    }

    function isParentForTeam(teamId) {
      let userPath = /databases/(default)/documents/users/$(request.auth.uid);
      return isSignedIn() &&
        firestore.exists(userPath) &&
        teamId in firestore.get(userPath).data.get('parentTeamIds', []);
    }

    function canAccessTeamMedia(teamId) {
      return isTeamOwnerOrAdmin(teamId) || isParentForTeam(teamId);
    }

    function isParentForPlayer(teamId, playerId) {
      let userPath = /databases/(default)/documents/users/$(request.auth.uid);
      return isSignedIn() &&
        firestore.exists(userPath) &&
        (teamId + '::' + playerId) in firestore.get(userPath).data.get('parentPlayerKeys', []);
    }

    function chatConversationPath(teamId, conversationId) {
      return /databases/(default)/documents/teams/$(teamId)/chatConversations/$(conversationId);
    }

    function isChatConversationParticipant(teamId, conversationId) {
      let conversationPath = chatConversationPath(teamId, conversationId);
      let conversation = firestore.get(conversationPath).data;
      let participantIds = conversation.get('participantIds', []);
      return conversationId.size() > 0 &&
        firestore.exists(conversationPath) &&
        (conversation.get('type', '') == 'team' ||
         request.auth.uid in participantIds ||
         ('user:' + request.auth.uid) in participantIds ||
         (request.auth.token.email != null &&
          ('email:' + request.auth.token.email.lower()) in participantIds));
    }

    function isParticipantOnlyAcceptedFriendChatConversation(teamId, conversationId) {
      let conversationPath = chatConversationPath(teamId, conversationId);
      let conversation = firestore.get(conversationPath).data;
      return conversationId.size() > 0 &&
        firestore.exists(conversationPath) &&
        conversation.get('type', '') == 'direct' &&
        conversation.get('directAccess', '') == 'accepted_friend';
    }

    function canAccessChatAttachment(teamId, conversationId) {
      return canAccessTeamMedia(teamId) &&
        (!isParticipantOnlyAcceptedFriendChatConversation(teamId, conversationId) ||
         request.auth.uid in firestore.get(chatConversationPath(teamId, conversationId)).data.get('directUserIds', [])) &&
        (conversationId == 'team' ||
         isTeamOwnerOrAdmin(teamId) ||
         isChatConversationParticipant(teamId, conversationId));
    }

    function hasTeamMediaUploadGrant(teamId) {
      let userPath = /databases/(default)/documents/users/$(request.auth.uid);
      return isSignedIn() &&
        firestore.exists(userPath) &&
        (teamId in firestore.get(userPath).data.get('teamMediaUploadTeamIds', []) ||
         teamId in firestore.get(userPath).data.get('mediaUploadTeamIds', []));
    }

    function canUploadTeamMediaFolder(teamId, folderId) {
      let folderPath = /databases/(default)/documents/teams/$(teamId)/mediaFolders/$(folderId);
      return folderId.size() > 0 &&
        firestore.exists(folderPath) &&
        firestore.get(folderPath).data.get('visibility', 'team') == 'team';
    }

    function canCreateTeamMediaUpload(teamId, folderId) {
      return canManageTeamMedia(teamId) ||
        (hasTeamMediaUploadGrant(teamId) && canUploadTeamMediaFolder(teamId, folderId));
    }

    function canReadTeamMediaObject(teamId, folderId) {
      let folderPath = /databases/(default)/documents/teams/$(teamId)/mediaFolders/$(folderId);
      return canManageTeamMedia(teamId) ||
        (isParentForTeam(teamId) &&
         folderId.size() > 0 &&
         firestore.exists(folderPath) &&
         firestore.get(folderPath).data.get('visibility', 'team') == 'team');
    }

    function canDeleteOwnTeamMediaObject(teamId, folderId, userId) {
      return isSignedIn() &&
        request.auth.uid == userId &&
        (canReadTeamMediaObject(teamId, folderId) ||
         (hasTeamMediaUploadGrant(teamId) && canUploadTeamMediaFolder(teamId, folderId)));
    }

    function canDeleteOwnChatAttachment(teamId, conversationId, userId) {
      return isSignedIn() &&
        request.auth.uid == userId &&
        canAccessChatAttachment(teamId, conversationId);
    }

    function canDeleteOwnTeamScopedUpload(teamId, userId) {
      return isSignedIn() &&
        request.auth.uid == userId &&
        canAccessTeamMedia(teamId);
    }

    function isAllowedTeamMediaUploadType(contentType) {
      return contentType.matches('image/.*') ||
        contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/vnd.ms-powerpoint',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation',
          'text/plain',
          'text/csv'
        ];
    }

    function isAllowedAthleteProfileMediaUploadType(contentType) {
      return contentType.matches('image/.*') ||
        contentType.matches('video/.*');
    }

    function isAllowedProfilePhotoUpload(contentType, size) {
      return size > 0 &&
        size <= 10 * 1024 * 1024 &&
        contentType.matches('image/.*');
    }

    function isAllowedChatAttachmentUpload(contentType, size) {
      return size > 0 &&
        size <= 5 * 1024 * 1024 &&
        (contentType.matches('image/.*') ||
         contentType.matches('video/.*'));
    }

    function isAllowedStatSheetUpload(contentType, size) {
      return size > 0 &&
        size <= 20 * 1024 * 1024 &&
        contentType.matches('image/.*');
    }

    function isAllowedDrillDiagramUpload(contentType, size) {
      return size > 0 &&
        size <= 20 * 1024 * 1024 &&
        contentType.matches('image/.*');
    }

    function storageGamePath(teamId, gameId) {
      return /databases/(default)/documents/teams/$(teamId)/games/$(gameId);
    }

    function isScorekeeperVisibleStorageGame(teamId, gameId) {
      let gamePath = storageGamePath(teamId, gameId);
      return firestore.exists(gamePath) &&
        firestore.get(gamePath).data.get('status', 'scheduled') != 'cancelled' &&
        firestore.get(gamePath).data.get('liveStatus', '') != 'deleted';
    }

    function hasConfirmedStorageGameRsvp(teamId, gameId) {
      let rsvpPath = /databases/(default)/documents/teams/$(teamId)/games/$(gameId)/rsvps/$(request.auth.uid);
      return firestore.exists(rsvpPath) &&
        firestore.get(rsvpPath).data.get('response', firestore.get(rsvpPath).data.get('status', '')) in
          ['going', 'yes', 'confirmed', 'attending'];
    }

    function canScorekeepStorageGame(teamId, gameId) {
      return isSignedIn() &&
        isScorekeeperVisibleStorageGame(teamId, gameId) &&
        ((teamPermission(teamId, 'scorekeeping').get('mode', '') == 'all_confirmed' &&
          hasConfirmedStorageGameRsvp(teamId, gameId)) ||
         (teamPermission(teamId, 'scorekeeping').get('mode', '') == 'selected' &&
          request.auth.uid in teamPermission(teamId, 'scorekeeping').get('memberIds', [])));
    }

    function canVideographStorageGame(teamId, gameId) {
      return isSignedIn() &&
        isScorekeeperVisibleStorageGame(teamId, gameId) &&
        (isTeamOwnerOrAdmin(teamId) ||
         request.auth.uid in teamPermission(teamId, 'videography').get('memberIds', []));
    }

    function isAllowedCertificateImageUpload(contentType, size) {
      return size > 0 &&
        size <= 5 * 1024 * 1024 &&
        contentType in ['image/png', 'image/jpeg', 'image/jpg', 'image/webp'];
    }

    function athleteProfileMatchesPathOwner(userId, profileId) {
      let profilePath = /databases/(default)/documents/athleteProfiles/$(profileId);
      return profileId.size() > 0 &&
        firestore.exists(profilePath) &&
        firestore.get(profilePath).data.parentUserId == userId;
    }

    function canReadAthleteProfileMedia(userId, profileId) {
      let profilePath = /databases/(default)/documents/athleteProfiles/$(profileId);
      return athleteProfileMatchesPathOwner(userId, profileId) &&
        ((isSignedIn() && request.auth.uid == userId) ||
         firestore.get(profilePath).data.get('privacy', 'private') == 'public');
    }

    match /team-media/{teamId}/{folderId}/{userId}/{fileName} {
      allow get: if canReadTeamMediaObject(teamId, folderId);
      allow list: if false;
      allow create: if isVerifiedForSensitiveWrite() &&
        canCreateTeamMediaUpload(teamId, folderId) &&
        (canManageTeamMedia(teamId) || request.auth.uid == userId) &&
        request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        isAllowedTeamMediaUploadType(request.resource.contentType);
      allow delete: if isVerifiedForSensitiveWrite() &&
        (canManageTeamMedia(teamId) || canDeleteOwnTeamMediaObject(teamId, folderId, userId));
      allow update: if false;
    }

    match /team-email-attachments/{teamId}/{draftId}/{userId}/{fileName} {
      allow get: if isTeamOwnerOrAdmin(teamId);
      allow list: if false;
      allow create: if isVerifiedForSensitiveWrite() &&
        isTeamOwnerOrAdmin(teamId) &&
        request.auth.uid == userId &&
        request.resource.size > 0 &&
        request.resource.size <= 20 * 1024 * 1024;
      allow delete: if isVerifiedForSensitiveWrite() && isTeamOwnerOrAdmin(teamId);
      allow update: if false;
    }

    match /certificate-assets/teams/{teamId}/{fileName} {
      allow get: if isTeamOwnerOrAdmin(teamId);
      allow list: if false;
      allow create: if isVerifiedForSensitiveWrite() &&
        isTeamOwnerOrAdmin(teamId) &&
        isAllowedCertificateImageUpload(request.resource.contentType, request.resource.size);
      allow delete: if isVerifiedForSensitiveWrite() && isTeamOwnerOrAdmin(teamId);
      allow update: if false;
    }

    match /certificate-signatures/users/{userId}/{fileName} {
      // Legacy user-scoped signatures remain readable/deletable by their uploader.
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedForSensitiveWrite() &&
        request.auth.uid == userId &&
        isAllowedCertificateImageUpload(request.resource.contentType, request.resource.size);
      allow delete: if isVerifiedForSensitiveWrite() && request.auth.uid == userId;
      allow update: if false;
    }

    match /certificate-signatures/teams/{teamId}/{fileName} {
      allow get: if isTeamOwnerOrAdmin(teamId);
      allow list: if false;
      allow create: if isVerifiedForSensitiveWrite() &&
        isTeamOwnerOrAdmin(teamId) &&
        isAllowedCertificateImageUpload(request.resource.contentType, request.resource.size);
      allow delete: if isVerifiedForSensitiveWrite() && isTeamOwnerOrAdmin(teamId);
      allow update: if false;
    }

    match /stat-sheets/team-chat/{teamId}/{conversationId}/{userId}/{fileName} {
      allow get: if canAccessChatAttachment(teamId, conversationId);
      allow list: if false;
      allow create: if ((isSignedIn() && conversationId == 'team') ||
        isVerifiedForSensitiveWrite()) &&
        canAccessChatAttachment(teamId, conversationId) &&
        request.auth.uid == userId &&
        isAllowedChatAttachmentUpload(request.resource.contentType, request.resource.size);
      allow delete: if (isVerifiedForSensitiveWrite() &&
        isTeamOwnerOrAdmin(teamId) &&
        canAccessChatAttachment(teamId, conversationId)) ||
        canDeleteOwnChatAttachment(teamId, conversationId, userId);
      allow update: if false;
    }

    match /stat-sheets/team-chat/{teamId}/team/{userId}/{fileName} {
      allow get: if canAccessChatAttachment(teamId, 'team') &&
        (isTeamOwnerOrAdmin(teamId) || request.auth.uid == userId);
      allow list: if false;
      allow create: if isSignedIn() &&
        canAccessChatAttachment(teamId, 'team') &&
        request.auth.uid == userId &&
        isAllowedChatAttachmentUpload(request.resource.contentType, request.resource.size);
      allow delete: if (isVerifiedForSensitiveWrite() && isTeamOwnerOrAdmin(teamId)) ||
        canDeleteOwnChatAttachment(teamId, 'team', userId);
      allow update: if false;
    }

    match /stat-sheets/team-chat/{teamId}/{userId}/{fileName} {
      allow get: if isTeamOwnerOrAdmin(teamId) || request.auth.uid == userId;
      allow list: if false;
      allow create: if false;
      allow delete: if isVerifiedForSensitiveWrite() &&
        (isTeamOwnerOrAdmin(teamId) || canDeleteOwnTeamScopedUpload(teamId, userId));
      allow update: if false;
    }

    match /stat-sheets/team-games/{teamId}/{gameId}/{userId}/{fileName} {
      allow get: if isTeamOwnerOrAdmin(teamId) ||
        (request.auth.uid == userId && canScorekeepStorageGame(teamId, gameId));
      allow list: if false;
      allow create: if isVerifiedForSensitiveWrite() &&
        request.auth.uid == userId &&
        (isTeamOwnerOrAdmin(teamId) || canScorekeepStorageGame(teamId, gameId)) &&
        isScorekeeperVisibleStorageGame(teamId, gameId) &&
        isAllowedStatSheetUpload(request.resource.contentType, request.resource.size);
      allow delete: if isVerifiedForSensitiveWrite() &&
        (isTeamOwnerOrAdmin(teamId) ||
         (request.auth.uid == userId && canScorekeepStorageGame(teamId, gameId)));
      allow update: if false;
    }

    match /stat-sheets/team-games/{teamId}/{userId}/{fileName} {
      // Legacy game-less objects are compatibility-only: existing references
      // may be read or cleaned up, but no caller can create or replace one.
      allow get: if isTeamOwnerOrAdmin(teamId) ||
        (request.auth.uid == userId && canAccessTeamMedia(teamId));
      allow list: if false;
      allow create, update: if false;
      allow delete: if isVerifiedForSensitiveWrite() &&
        (isTeamOwnerOrAdmin(teamId) || canDeleteOwnTeamScopedUpload(teamId, userId));
    }

    match /stat-sheets/drills/{teamId}/{drillId}/{userId}/{fileName} {
      allow get: if canAccessTeamMedia(teamId);
      allow list: if false;
      allow create: if isVerifiedForSensitiveWrite() &&
        isTeamOwnerOrAdmin(teamId) &&
        drillId.size() > 0 &&
        request.auth.uid == userId &&
        isAllowedDrillDiagramUpload(request.resource.contentType, request.resource.size);
      allow delete: if isVerifiedForSensitiveWrite() &&
        (isTeamOwnerOrAdmin(teamId) || canDeleteOwnTeamScopedUpload(teamId, userId));
      allow update: if false;
    }

    match /stat-sheets/{fileName} {
      allow get, create, delete: if false;
      allow list, update: if false;
    }

    match /game-clips/{teamId}/{gameId}/{userId}/{fileName} {
      allow get: if canAccessTeamMedia(teamId);
      allow list: if false;
      allow create: if isVerifiedForSensitiveWrite() &&
        canVideographStorageGame(teamId, gameId) &&
        request.auth.uid == userId &&
        request.resource.size > 0 &&
        request.resource.size <= 50 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
      allow delete: if isVerifiedForSensitiveWrite() &&
        (isTeamOwnerOrAdmin(teamId) || canDeleteOwnTeamScopedUpload(teamId, userId));
      allow update: if false;
    }

    match /game-clips/{fileName} {
      allow get, create, delete: if false;
      allow list, update: if false;
    }

    match /athlete-profile-media/{userId}/{profileId}/{fileName} {
      allow get: if canReadAthleteProfileMedia(userId, profileId);
      allow list: if false;
      allow create: if isVerifiedForSensitiveWrite() &&
        request.auth.uid == userId &&
        athleteProfileMatchesPathOwner(userId, profileId) &&
        request.resource.size > 0 &&
        request.resource.size <= 100 * 1024 * 1024 &&
        isAllowedAthleteProfileMediaUploadType(request.resource.contentType);
      allow delete: if isVerifiedForSensitiveWrite() &&
        request.auth.uid == userId &&
        athleteProfileMatchesPathOwner(userId, profileId);
      allow update: if false;
    }

    match /profile-photos/users/{userId}/{fileName} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        isAllowedProfilePhotoUpload(request.resource.contentType, request.resource.size);
      allow delete: if isSignedIn() && request.auth.uid == userId;
      allow update: if false;
    }

    // Player and team photos use resource-scoped object names because Firebase
    // download URLs expose the encoded Storage path. Authorization comes from
    // the team/player relationship, never an uploader UID embedded in the URL.
    match /profile-photos/teams/{teamId}/players/{playerId}/{fileName} {
      allow get: if canAccessTeamMedia(teamId);
      allow list: if false;
      allow create: if isSignedIn() &&
        (isTeamOwnerOrAdmin(teamId) || isParentForPlayer(teamId, playerId)) &&
        isAllowedProfilePhotoUpload(request.resource.contentType, request.resource.size);
      allow delete: if isSignedIn() &&
        (isTeamOwnerOrAdmin(teamId) || isParentForPlayer(teamId, playerId));
      allow update: if false;
    }

    match /profile-photos/teams/{teamId}/team/{fileName} {
      allow get: if canAccessTeamMedia(teamId);
      allow list: if false;
      allow create: if isVerifiedForSensitiveWrite() &&
        isTeamOwnerOrAdmin(teamId) &&
        isAllowedProfilePhotoUpload(request.resource.contentType, request.resource.size);
      allow delete: if isVerifiedForSensitiveWrite() && isTeamOwnerOrAdmin(teamId);
      allow update: if false;
    }
  }
}
