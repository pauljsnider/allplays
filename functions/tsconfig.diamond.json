{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "ignoreDeprecations": "6.0",
    "rootDir": "../apps/app/src/lib/diamondScorebook",
    "outDir": "./diamond-engine",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "declaration": false,
    "sourceMap": false,
    "noEmit": false
  },
  "include": ["../apps/app/src/lib/diamondScorebook/*.ts"],
  "exclude": ["../apps/app/src/lib/diamondScorebook/*.test.ts"]
}
