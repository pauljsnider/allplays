{
  "schemaVersion": "parent-coverage-contract-v1",
  "workflowId": "P10",
  "title": "Parent home action queue and navigation",
  "actors": [
    "primary"
  ],
  "viewport": "mobile",
  "mutatesProduction": false,
  "cleanupRequired": false,
  "lifecycleTransition": false,
  "steps": [
    {
      "action": "login",
      "actor": "primary"
    },
    {
      "action": "goto",
      "actor": "primary",
      "route": "/home"
    },
    {
      "action": "expectVisible",
      "actor": "primary",
      "target": {
        "kind": "text",
        "name": "Family home",
        "exact": false
      }
    },
    {
      "action": "expectVisible",
      "actor": "primary",
      "target": {
        "kind": "role",
        "role": "heading",
        "name": "Upcoming",
        "exact": true
      }
    },
    {
      "action": "clickAndExpectRoute",
      "actor": "primary",
      "target": {
        "kind": "role",
        "role": "link",
        "name": "Schedule",
        "exact": true
      },
      "route": "/schedule"
    },
    {
      "action": "expectVisible",
      "actor": "primary",
      "target": {
        "kind": "role",
        "role": "heading",
        "name": "Schedule",
        "exact": true
      }
    },
    {
      "action": "expectRoute",
      "actor": "primary",
      "route": "/schedule"
    }
  ],
  "cleanupSteps": []
}
