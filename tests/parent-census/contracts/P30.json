      "actor": "primary",
      "target": {
        "kind": "role",
        "role": "button",
        "name": "Pay fee",
        "exact": true
      }
    },
    {
      "action": "clickAndExpectStripeCheckout",
      "actor": "primary",
      "target": {
        "kind": "role",
        "role": "button",
        "name": "Pay fee",
        "exact": true
      }
    }
