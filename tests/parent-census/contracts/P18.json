{
  "schemaVersion": "parent-coverage-contract-v1",
  "workflowId": "P18",
  "title": "Practice attendance summary is parent read-only",
  "actors": [
    "primary"
  ],
  "viewport": "mobile",
  "mutatesProduction": false,
  "cleanupRequired": false,
  "lifecycleTransition": false,
  "steps": [
    {
      "action": "login",
      "actor": "primary"
    },
    {
      "action": "goto",
      "actor": "primary",
      "route": "/schedule/{TEAM_ID}/{EVENT_ID}?section=game"
    },
    {
      "action": "expectRoute",
      "actor": "primary",
      "route": "/schedule/{TEAM_ID}/{EVENT_ID}?section=game"
    },
    {
      "action": "expectVisible",
      "actor": "primary",
      "target": {
        "kind": "role",
        "role": "heading",
        "name": "Practice hub",
        "exact": true
      }
    },
    {
      "action": "expectVisible",
      "actor": "primary",
      "target": {
        "kind": "text",
        "name": "Practice attendance",
        "exact": true
      }
    },
    {
      "action": "expectVisible",
      "actor": "primary",
      "target": {
        "kind": "text",
        "name": "present",
        "exact": false
      }
    },
    {
      "action": "expectHidden",
      "actor": "primary",
      "target": {
        "kind": "text",
        "name": "Mark each player present, late, or absent.",
        "exact": true
      }
    },
    {
      "action": "expectHidden",
      "actor": "primary",
      "target": {
        "kind": "role",
        "role": "button",
        "name": "Present",
        "exact": true
      }
    },
    {
      "action": "expectHidden",
      "actor": "primary",
      "target": {
        "kind": "text",
        "name": "Take attendance",
        "exact": true
      }
    }
  ],
  "cleanupSteps": []
