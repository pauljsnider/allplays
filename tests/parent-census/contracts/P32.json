{
  "schemaVersion": "parent-coverage-contract-v1",
  "workflowId": "P32",
  "title": "Awards and certificate viewing and download",
  "actors": [
    "primary"
  ],
  "viewport": "mobile",
  "mutatesProduction": false,
  "cleanupRequired": false,
  "lifecycleTransition": false,
  "steps": [
    {
      "action": "login",
      "actor": "primary"
    },
    {
      "action": "goto",
      "actor": "primary",
      "route": "/parent-tools/certificates"
    },
    {
      "action": "expectRoute",
      "actor": "primary",
      "route": "/parent-tools/certificates"
    },
    {
      "action": "expectVisible",
      "actor": "primary",
      "target": {
        "kind": "role",
        "role": "heading",
        "name": "Awards",
        "exact": true
      }
    },
    {
      "action": "expectText",
      "actor": "primary",
      "target": {
        "kind": "text",
        "name": "Published certificates for linked players.",
        "exact": true
      },
      "value": "Published certificates for linked players."
    },
    {
      "action": "clickAndExpectDownload",
      "actor": "primary",
      "target": {
        "kind": "role",
        "role": "button",
        "name": "Download certificate",
        "exact": true
      }
    }
  ],
  "cleanupSteps": []
}
